// Despliegue del frontend en Cloudflare Workers (solo archivos estáticos, sin código de
// servidor). Cloudflare ejecuta `npm run build` y después `npx wrangler deploy`, que publica
// la carpeta dist. El archivo dist/_headers (generado en vite.config.js) aplica las cabeceras
// de seguridad, igual que en Cloudflare Pages.
{
  "name": "portfolio-ia-agent",
  "compatibility_date": "2026-10-01",
  // Solo el dominio propio (alejandrocerezo.dev): sin dirección workers.dev ni URLs de vista previa.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Entorno de desarrollo: otro Worker (dev.alejandrocerezo.dev) que Cloudflare publica desde la
  // rama dev con `npx wrangler deploy --env dev`. Hereda assets, workers_dev y preview_urls.
  "env": {
    "dev": {
      "name": "portfolio-ia-agent-dev"
    }
  }
}
