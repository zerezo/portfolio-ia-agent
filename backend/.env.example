PORT=3000
# Perfil de límites: funcional (por defecto, el más estricto) | normal | amplio
LIMIT_PROFILE=funcional
# Saltos de proxy de confianza: 1 = Railway; 2 = Cloudflare + Railway
TRUST_PROXY=1

# Proveedor de modelo: ollama (por defecto, local y gratuito) | anthropic (de pago)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Solo si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Formulario de contacto: email que recibe los avisos y remitente de los emails.
# Con MAIL_TRANSPORT=gmail, MAIL_FROM debe ser la dirección de la cuenta de Gmail del proyecto.
OWNER_EMAIL=
MAIL_FROM=Portfolio <no-reply@localhost>

# Envío de emails: file (por defecto, archivos .eml en OUTBOX_DIR) | gmail (API de Gmail por HTTPS;
# Railway bloquea el SMTP en los planes Free/Hobby).
MAIL_TRANSPORT=file
OUTBOX_DIR=outbox
# Solo con gmail. GMAIL_REFRESH_TOKEN lo escribe npm run gmail:auth.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
OWNER_NAME=Alejandro
# URL pública del backend (enlaces de revisión de los emails) y secreto para firmarlos.
# Genera el secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_URL=http://localhost:3000
REVIEW_SECRET=

# Orígenes del frontend con acceso a la API, separados por comas (en local no hace falta:
# Vite redirige /api al backend). Ej.: https://alejandrocerezo.dev,https://www.alejandrocerezo.dev
CORS_ORIGINS=
